{
  "version": "1.0.0",
  "description": "CMS",
  "name": "core-bundler",
  "private": true,
  "scripts": {
    "update": "git pull && npm run coreProd && npm run createResourceFile && npm run coreModuleProd",

    "startLIVEReload": "webpack-dev-server",

    "createResourceFile": "node ./bundler/createResourceFile.js",
    "coreProd": "webpack --env production --config ./bundler/webpack.config.js",
    "coreModuleProd": "webpack --env production --config ./bundler/webpack.module.js",

    "type-check": "vue-tsc --build",
    "coreDev": "webpack --config ./bundler/webpack.config.js",
    "coreModuleDev": "webpack --config ./bundler/webpack.module.js"
  },
  "dependencies": {
    "@syncfusion/ej2-kanban": "^30.2.4",
    "@tiptap/extension-color": "latest",
    "@tiptap/extension-highlight": "latest",
    "@tiptap/extension-link": "latest",
    "@tiptap/extension-text-align": "latest",
    "@tiptap/extension-text-style": "latest",
    "@tiptap/starter-kit": "latest",
    "@tiptap/vue-3": "latest",
    "diff": "^8.0.3",
    "mustache": "latest",
    "normalize-scss": "latest",
    "primevue": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "latest",
    "css-loader": "latest",
    "css-minimizer-webpack-plugin": "latest",
    "cypress-watch-and-reload": "latest",
    "file-loader": "latest",
    "mini-css-extract-plugin": "latest",
    "sass": "latest",
    "sass-loader": "latest",
    "style-loader": "latest",
    "svgo-loader": "latest",
    "typescript": "latest",
    "vue-loader": "next",
    "webpack": "latest",
    "webpack-cli": "latest"
  }
}
