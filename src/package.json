{
  "version": "1.0.0",
  "description": "CMS",
  "name": "core-bundler",
  "private": true,
  "scripts": {
    "update": "git pull && npm run coreProd && npm run createResourceFile && npm run coreModuleProd",

    "startLIVEReload": "webpack-dev-server",

    "createResourceFile": "node ./bundler/createResourceFile.js",
    "coreProd": "webpack --env production --config ./bundler/webpack.config.js",
    "coreModuleProd": "webpack --env production --config ./bundler/webpack.module.js",

    "type-check": "vue-tsc --build",
    "coreDev": "webpack --config ./bundler/webpack.config.js",
    "coreModuleDev": "webpack --config ./bundler/webpack.module.js"
  },
  "dependencies": {
    "@primevue/themes": "^4.2.5",
    "@tiptap/extension-color": "2.27.2",
    "@tiptap/extension-dropcursor": "2.27.2",
    "@tiptap/extension-highlight": "2.27.2",
    "@tiptap/extension-history": "2.27.2",
    "@tiptap/extension-image": "2.27.2",
    "@tiptap/extension-link": "2.27.2",
    "@tiptap/extension-text-align": "2.27.2",
    "@tiptap/extension-text-style": "2.27.2",
    "@tiptap/starter-kit": "2.27.2",
    "@tiptap/vue-3": "2.27.2",
    "diff": "^9.0.0",
    "lodash": "^4.18.1",
    "mustache": "^4.2.0",
    "primevue": "^4.3.5",
    "vue": "3.5.35"
  },
  "devDependencies": {
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.0",
    "typescript": "^6.0.3",
    "vue-loader": "^17.4.2",
    "webpack-cli": "^7.0.3"
  }
}
