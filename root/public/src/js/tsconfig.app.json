{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "./js/**/*.ts",
    "./js/**/*.vue"
  ],
  "exclude": ["../js/**/__tests__/*", "./**"],
  "compilerOptions": {
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@/*": ["*"],
    },

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],

    "noImplicitThis": false,

    "moduleResolution": "node",
    "types": ["vue"],
    "typeRoots": [
      "../node_modules/@types",
      "../node_modules"
    ],
  }
}
